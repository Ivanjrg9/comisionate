# Supabase (Project settings → API). En local: `supabase status`
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Solo servidor (nunca con prefijo NEXT_PUBLIC_): para seed, tareas y tests
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Emails (Resend) y tarea programada de envío
RESEND_API_KEY=
EMAIL_FROM="ComisionaTe <avisos@comisionate.com>"
CRON_SECRET=
# IBAN al que las empresas pagan la tarifa mensual (sale en el PDF de la factura)
PLATFORM_IBAN=
# Datos del titular para los textos legales (aviso legal, privacidad)
NEXT_PUBLIC_LEGAL_NAME=
NEXT_PUBLIC_LEGAL_TAX_ID=
NEXT_PUBLIC_LEGAL_ADDRESS=
NEXT_PUBLIC_LEGAL_REGISTRY=
NEXT_PUBLIC_LEGAL_EMAIL=
# Pon true cuando hayas activado Google en Supabase (Authentication → Providers)
NEXT_PUBLIC_GOOGLE_ENABLED=false
